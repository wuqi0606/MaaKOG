{
    "interface_version": 2,
    "name": "MaaKOG",
    "description": "少女回战（KOG）自动化脚本，基于 MaaFramework 构建。",
    "contact": "GitHub: wuqi0606",
    "license": "MIT",
    "welcome": "欢迎使用 MaaKOG！少女回战日常自动化。",
    "github": "https://github.com/wuqi0606/MaaKOG",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端（模拟器）",
            "type": "Adb",
            "display_short_side": 720
